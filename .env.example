# Copy to .env and change the values. Never commit .env.

# Database. Use letters and digits in the password (it is placed in a URL unencoded).
POSTGRES_USER=filemana
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filemana
# Used by the backend and Prisma CLI on your machine (outside Docker). Compose builds its own URL.
DATABASE_URL=postgresql://filemana:change-me@localhost:5432/filemana

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# true when served over HTTPS
COOKIE_SECURE=false
# Where uploaded files are stored (Compose mounts a volume and sets its own path)
UPLOAD_DIR=uploads
# Sign-in and sign-up tries per minute per IP (NFR-04)
THROTTLE_LIMIT=20

# Web
# The address the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production only (docker-compose.prod.yml on the VPS)
# Where Caddy listens. 8080: open at http://<ip>:8080. With a domain, set 127.0.0.1:8080 and point the
# VPS's Nginx (HTTPS) at it; then WEB_ORIGIN=https://app.example.com, COOKIE_SECURE=true and the
# NEXT_PUBLIC_API_URL repository variable on GitHub is https://app.example.com/api.
HTTP_PORT=8080
# Written by each deploy (a commit sha); set an older one to roll back.
IMAGE_TAG=

# First account and workspace, created by the seed (FR-ROLE-01)
WORKSPACE_NAME=FileMana
SEED_EMAIL=admin@example.com
SEED_NAME=Admin
SEED_PASSWORD=change-me-too
