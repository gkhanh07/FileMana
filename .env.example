# Copy to .env and change the values. Never commit .env.

# Database. Use letters and digits in the password (it is placed in a URL unencoded).
POSTGRES_USER=filemana
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filemana
# Used by the backend and Prisma CLI on your machine (outside Docker). Compose builds its own URL.
DATABASE_URL=postgresql://filemana:change-me@localhost:5432/filemana

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# true when served over HTTPS
COOKIE_SECURE=false
# Where uploaded files are stored (Compose mounts a volume and sets its own path)
UPLOAD_DIR=uploads

# Web
# The address the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# First account and workspace, created by the seed (FR-ROLE-01)
WORKSPACE_NAME=FileMana
SEED_EMAIL=admin@example.com
SEED_NAME=Admin
SEED_PASSWORD=change-me-too
