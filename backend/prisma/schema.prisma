generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

enum Theme {
  light
  dark
  system
}

model Workspace {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  timezone     String   @default("Asia/Ho_Chi_Minh")
  weekStartsOn Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  name          String
  jobTitle      String?
  avatarFile    String?
  passwordHash  String?
  status        UserStatus        @default(ACTIVE)
  theme         Theme             @default(system)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  ownedProjects Project[]         @relation("ProjectOwner")
  memberships   ProjectMember[]
  favorites     FavoriteProject[]
  activities    Activity[]
  assignedTasks Task[]            @relation("TaskAssignee")
  createdTasks  Task[]            @relation("TaskCreator")
  items         Item[]
  comments      Comment[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remember   Boolean
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique
  name        String            @db.VarChar(80)
  description String?
  color       String
  status      ProjectStatus     @default(PLANNING)
  startDate   DateTime?         @db.Date
  dueDate     DateTime?         @db.Date
  ownerId     String            @db.Uuid
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  taskCounter Int               @default(0)
  members     ProjectMember[]
  favorites   FavoriteProject[]
  activities  Activity[]
  tasks       Task[]
  milestones  Milestone[]
  folder      Item?

  @@index([ownerId])
  @@index([deletedAt])
}

model ProjectMember {
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model FavoriteProject {
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int

  @@id([userId, projectId])
  @@index([projectId])
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id])
  projectId  String?  @db.Uuid
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String   @db.Uuid
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  parentId    String?      @db.Uuid
  parent      Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("Subtasks")
  title       String       @db.VarChar(200)
  description Json?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String       @db.Uuid
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])
  dueDate     DateTime?    @db.Date
  dueTime     String?      @db.VarChar(5)
  completedAt DateTime?
  position    Float
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  milestoneId String?      @db.Uuid
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  labels      TaskLabel[]
  attachments Item[]
  comments    Comment[]

  @@unique([projectId, number])
  @@index([parentId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
}

model Milestone {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(80)
  date      DateTime  @db.Date
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tasks     Task[]

  @@index([projectId])
}

model Label {
  id    String      @id @default(uuid()) @db.Uuid
  name  String      @unique @db.VarChar(40)
  color String
  tasks TaskLabel[]
}

model TaskLabel {
  taskId  String @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

enum ItemKind {
  FOLDER
  FILE
}

model Item {
  id        String    @id @default(uuid()) @db.Uuid
  kind      ItemKind
  name      String    @db.VarChar(255)
  parentId  String?   @db.Uuid
  parent    Item?     @relation("ItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Item[]    @relation("ItemTree")
  projectId String?   @unique @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?   @db.Uuid
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commentId String?   @db.Uuid
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  creatorId String?   @db.Uuid
  creator   User?     @relation(fields: [creatorId], references: [id])
  mimeType  String?   @db.VarChar(255)
  size      Int?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([taskId])
  @@index([commentId])
}

model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @db.Uuid
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id])
  body        String    @db.VarChar(10000)
  mentionIds  String[]  @db.Uuid
  attachments Item[]
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([taskId, createdAt])
}
